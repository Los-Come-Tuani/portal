# Plantilla de variables de entorno. Vite las carga de menor a mayor prioridad:
#   .env  <  .env.local  <  .env.[modo]  <  .env.[modo].local
# (y una variable ya definida en el entorno del proceso gana a todos los archivos).
# Solo se versionan .env.development, .env.production y .env.demo, y sin secretos: todo
# `VITE_*` termina dentro del bundle del navegador. Para un valor propio en desarrollo,
# crea `.env.development.local` (no se versiona).

# URL base de la API de K'Plan, sin "/" al final.
#   - desarrollo: /_api, el proxy de Vite (ver .env.development y vite.config.ts)
#   - publicado: https://develop-api.kplan.dev (ver .env.production; el build falla sin ella)
VITE_API_URL=

# Solo `npm run dev`: a dónde reenvía el proxy `/_api`. No lleva `VITE_`: no entra al bundle.
#   - API de desarrollo publicado: https://develop-api.kplan.dev (ver .env.development)
#   - API local: http://localhost:8080 (en .env.development.local)
API_PROXY_TARGET=

# Client ID OAuth de tipo Web. Es público y también lo usan el API y la app
# móvil como audiencia del token de identidad.
VITE_GOOGLE_CLIENT_ID=

# `true` = modo demo: backend simulado en el navegador, sin API (`npm run dev:demo`).
# Nunca en producción: `npm run build` falla si está activo.
VITE_USE_MOCKS=
