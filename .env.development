# Desarrollo local contra la API que corre en http://localhost:8080 (`just run` en el repo del API).
# Usa `localhost` y no `127.0.0.1`: portal y API deben compartir el mismo sitio para que las
# cookies de sesión viajen. Para un valor propio, crea `.env.development.local` (no se versiona).
# Solo valores públicos: todo `VITE_*` termina dentro del bundle.
VITE_API_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=552338673379-b5qoepfp6ogt04gnuidonrl72itheg4s.apps.googleusercontent.com
